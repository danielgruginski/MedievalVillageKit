    top+=[(xr,y,0.0,UP,FLAT_T) for y in (0.5,1.0,1.5) if y>1.5-P[TOP_ROW][0]+1e-6]
    top+=[(*side_pos(2,d,2),0.0,UP,FLAT_T) for d in (0,0.5,1.0,1.5,2.0,2.5,3.0) if 1.5-d<=xr+1e-6]
