    body=[v for v in k.bm.verts if abs(v.co.x)<=0.3 and abs(v.co.y)<=0.3 and -0.32<=v.co.z<=0.32 and not v.tag]
    for v in body:
        t=(v.co.z+0.31)/0.62                                     # 0 bottom .. 1 top
        r=0.27*(1.0+0.12*math.sin(t*math.pi))*(1.0-0.55*max(0.0,t-0.72)/0.28)
