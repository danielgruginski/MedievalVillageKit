    _cyl(k,(top.x,top.y,top.z+0.03*s),0.075*s,0.075*s,0.03*s,10,HIDE)
    _mat(_ico(k,(top.x,top.y,top.z+0.13*s),0.08*s,mi,scale=(1.2,1.0,0.6),sub=1,jit=0.012,seed=seed),mi)
