    kk=rng.uniform(0.02,0.05,N).astype(f32)
    d=smin(E1m,E2m,kk[ID])+0.004*fbm(S,2.0,seed+3,fmin=8,fmax=40)
    g=np.clip(0.012+0.005*fbm(S,2.0,seed+4,fmin=6,fmax=30),0.006,0.02).astype(f32)
