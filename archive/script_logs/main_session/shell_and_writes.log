            return base(d)
        out.append(dict(pos=pos,o=c["o"],var=True))
    return out
VARIANTS={("Cliff",EDGE):("A","B","C"),("Cliff",OUTER):("A","B"),("Cliff",INNER):("A","B"),("Shore",EDGE):("A","B")}
